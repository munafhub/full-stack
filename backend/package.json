{
  "name": "week2-tasks-api",
  "version": "1.0.0",
  "description": "Week 2 CRUD REST API with Express, Sequelize ORM, SQLite, Zod, ESLint and Vitest",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node src/resetDb.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "zod": "^4.1.5",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
