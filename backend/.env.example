# --- required in production (Railway > Variables) ---
JWT_SECRET=change-this-to-a-long-random-string

# Frontend origin(s) allowed by CORS. Comma separated, or * for any.
# The Vercel URL and http://localhost:5173 are already allowed by default.
FRONTEND_ORIGIN=https://full-stack-teal-seven.vercel.app

# --- database (pick ONE) ---
# A) SQLite on a Railway Volume (attach a Volume, mount path /data)
SQLITE_PATH=/data/tasks.sqlite
# B) PostgreSQL (npm install pg pg-hstore first). Overrides SQLite when set.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=true

# --- optional: auto-create an admin account on startup ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin123
